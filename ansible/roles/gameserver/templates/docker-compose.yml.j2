services:
  valheim:
    image: ghcr.io/lloesche/valheim-server
    profiles: ["valheim"]
    cap_add:
      - sys_nice
    volumes:
      - "/data/servers/valheim:/config" 
      - "./opt-valheim:/opt/valheim"
    ports:
      - "2456-2458:2456-2458/udp"
      - "127.0.0.1:9001:9001"
    env_file:
      - ./valheim.env
    restart: always
    stop_grace_period: 2m

  mc:
    image: itzg/minecraft-server:stable
    profiles: ["mc"]
    tty: true
    stdin_open: true
    networks:
      - my-net
    ports:
      - "25565:25565"
    environment:
      EULA: "TRUE"
      TYPE: "FABRIC"
      VERSION: "1.21.11"
      MEMORY: "2G"
      MOTD: "Big  Server"
      DIFFICULTY: "3"
      VIEW_DISTANCE: "24"
      ENABLE_WHITELIST: "true"
    volumes:
      - "/data/servers/mc:/data"
    restart: unless-stopped

networks:
  my-net:
    driver: bridge
    driver_opts:
      com.docker.network.driver.mtu: 1280
