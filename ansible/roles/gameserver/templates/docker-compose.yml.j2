services:
  valheim:
    image: ghcr.io/lloesche/valheim-server
    profiles: ["valheim"]
    cap_add:
      - sys_nice
    volumes:
      - "/data/servers/valheim:/config" 
      - "./opt-valheim:/opt/valheim"
    ports:
      - "2456-2458:2456-2458/udp"
      - "127.0.0.1:9001:9001"
    env_file:
      - ./valheim.env
    restart: always
    stop_grace_period: 2m

  mc:
    image: itzg/minecraft-server:stable
    profiles: ["mc"]
    tty: true
    stdin_open: true
    networks:
      - my-net
    ports:
      - "25565:25565"
    environment:
      EULA: "TRUE"
      TYPE: "FABRIC"
      VERSION: "1.21.11"
      MEMORY: "2G"
      MOTD: "Big  Server"
      DIFFICULTY: "3"
      VIEW_DISTANCE: "24"
      ENABLE_WHITELIST: "true"
    volumes:
      - "/data/servers/mc:/data"
    restart: unless-stopped

  mc-astral:
    image: itzg/minecraft-server:java17
    profiles: ["astral"]
    tty: true
    stdin_open: true
    networks:
      - my-net
    ports:
      - "25566:25565"
    environment:
      EULA: "TRUE"
      TYPE: "FABRIC"
      MEMORY: "8G"
      MOTD: "Astral Server"
      DIFFICULTY: "3"
      VIEW_DISTANCE: "16"
      ENABLE_WHITELIST: "true"
      VERSION: "1.18.2"
      FABRIC_LOADER_VERSION: "0.16.3"
    volumes:
      - "/data/servers/mc-astral:/data"
    restart: unless-stopped

networks:
  my-net:
    driver: bridge
    driver_opts:
      com.docker.network.driver.mtu: 1280
